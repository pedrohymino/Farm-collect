; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Farm Collect"
config/description="Cozy incremental farm game."
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/core/event_bus.gd"
ContentDB="*res://src/core/content_db.gd"
Stats="*res://src/core/stats/stat_system.gd"
GameState="*res://src/core/game_state.gd"
Economy="*res://src/core/economy.gd"
SaveManager="*res://src/core/save_manager.gd"
DevMode="*res://src/dev/dev_mode.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.en.translation", "res://locale/strings.pt_BR.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
